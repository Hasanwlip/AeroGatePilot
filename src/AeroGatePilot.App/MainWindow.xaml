<Window x:Class="AeroGatePilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AeroGatePilot.App.Localization"
        Title="AeroGate Pilot"
        Width="1320" Height="860" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/aerogate.ico"
        FlowDirection="{Binding FlowDirection, Source={x:Static l:Loc.Instance}}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Ambient glow -->
        <Ellipse Grid.Column="1" Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-320,-220,0" Opacity="0.20" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{StaticResource PrimaryColor}" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,18,18,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4,0,30">
                    <Image Source="pack://application:,,,/Assets/aerogate.png" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="18" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                            <Run Text="AeroGate" /><Run Text=" Pilot" Foreground="{StaticResource AccentBrush}" />
                        </TextBlock>
                        <TextBlock Text="{l:T App_Tagline}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Gateway status card -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource HeroGradient}" CornerRadius="16" Padding="16" Margin="0,16,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Pill}" Background="#22FFFFFF">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding StateBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StateText}" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Button Margin="0,14,0,0" Command="{Binding ToggleGatewayCommand}" HorizontalAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Background" Value="#33FF4757" />
                                            <Setter Property="BorderBrush" Value="#66FF4757" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE768;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Text" Value="&#xE71A;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding ToggleText}" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="0,8,0,0" Command="{Binding ToggleLanguageCommand}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" FontSize="13" />
                                <TextBlock Text="{l:T Lang_Toggle}" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="{l:T Nav_Dashboard}"
                                 IsChecked="{Binding CurrentPageKey, Converter={StaticResource EnumMatch}, ConverterParameter=dashboard}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE716;" Content="{l:T Nav_Users}"
                                 IsChecked="{Binding CurrentPageKey, Converter={StaticResource EnumMatch}, ConverterParameter=users}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8EC;" Content="{l:T Nav_Plans}"
                                 IsChecked="{Binding CurrentPageKey, Converter={StaticResource EnumMatch}, ConverterParameter=plans}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE701;" Content="{l:T Nav_Network}"
                                 IsChecked="{Binding CurrentPageKey, Converter={StaticResource EnumMatch}, ConverterParameter=network}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8D7;" Content="{l:T Nav_Portal}"
                                 IsChecked="{Binding CurrentPageKey, Converter={StaticResource EnumMatch}, ConverterParameter=portal}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE90F;" Content="{l:T Nav_Diagnostics}"
                                 IsChecked="{Binding CurrentPageKey, Converter={StaticResource EnumMatch}, ConverterParameter=diagnostics}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="{l:T Nav_Activity}"
                                 IsChecked="{Binding CurrentPageKey, Converter={StaticResource EnumMatch}, ConverterParameter=activity}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" />
                <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" />
            </StackPanel>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />

            <!-- Busy overlay while closing -->
            <Border x:Name="ClosingOverlay" Grid.RowSpan="2" Background="#CC0B1020" Visibility="Collapsed">
                <TextBlock Text="{l:T Msg_Stopping}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
            </Border>
        </Grid>
    </Grid>
</Window>
