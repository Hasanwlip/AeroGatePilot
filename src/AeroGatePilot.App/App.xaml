<Application x:Class="AeroGatePilot.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AeroGatePilot.App.ViewModels"
             xmlns:views="clr-namespace:AeroGatePilot.App.Views"
             xmlns:conv="clr-namespace:AeroGatePilot.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="Visible" />
            <conv:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
            <conv:InverseBoolConverter x:Key="Not" />
            <conv:EnumMatchConverter x:Key="EnumMatch" />
            <conv:DiagnosticBrushConverter x:Key="DiagBrush" />
            <conv:DiagnosticGlyphConverter x:Key="DiagGlyph" />
            <conv:HexToBrushConverter x:Key="HexBrush" />

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsersViewModel}"><views:UsersView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlansViewModel}"><views:PlansView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:NetworkViewModel}"><views:NetworkView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PortalViewModel}"><views:PortalView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><views:DiagnosticsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ActivityViewModel}"><views:ActivityView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
