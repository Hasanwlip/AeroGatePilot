<UserControl x:Class="AeroGatePilot.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AeroGatePilot.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,32,32">
        <StackPanel>
            <DockPanel Margin="0,0,0,22">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{l:T Btn_Save}" Command="{Binding SaveCommand}" VerticalAlignment="Center" MinWidth="120" />
                <StackPanel>
                    <TextBlock Text="{l:T Net_Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:T Net_Subtitle}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </DockPanel>

            <Border Background="#22FFA502" BorderBrush="#66FFA502" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                <TextBlock Text="{l:T Net_RestartNotice}" TextWrapping="Wrap" />
            </Border>
            <Border CornerRadius="12" Padding="14,10" Margin="0,0,0,16" BorderThickness="1"
                    Visibility="{Binding Message, Converter={StaticResource Visible}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#2200CEC9" />
                        <Setter Property="BorderBrush" Value="#6600CEC9" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                <Setter Property="Background" Value="#33FF4757" />
                                <Setter Property="BorderBrush" Value="#88FF4757" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Internet source + Wi-Fi -->
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Command="{Binding RefreshCommand}" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" />
                                </Button>
                                <TextBlock Text="{l:T Net_Wan}" Style="{StaticResource CardTitle}" />
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding WanOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Wifi.WanAdapterId}" />
                            <TextBlock Text="{l:T Net_WanHint}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T Net_Wifi}" Style="{StaticResource CardTitle}" />

                            <TextBlock Text="{l:T Net_Ssid}" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Wifi.Ssid, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />

                            <TextBlock Text="{l:T Net_Password}" Style="{StaticResource Label}" Margin="0,14,0,6" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{l:T Btn_Generate}" Command="{Binding GeneratePasswordCommand}" />
                                <TextBox Text="{Binding Wifi.Passphrase, UpdateSourceTrigger=PropertyChanged}" MaxLength="63" FontFamily="{StaticResource MonoFont}" FlowDirection="LeftToRight" />
                            </DockPanel>

                            <TextBlock Text="{l:T Net_Band}" Style="{StaticResource Label}" Margin="0,14,0,6" />
                            <ComboBox ItemsSource="{Binding Bands}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Wifi.Band}" />

                            <CheckBox Style="{StaticResource Toggle}" Content="{l:T Net_Open}" IsChecked="{Binding OpenNetwork}" Margin="0,18,0,0" />
                            <Border Background="#22FFA502" BorderBrush="#66FFA502" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,12,0,0"
                                    Visibility="{Binding OpenNetwork, Converter={StaticResource Visible}}">
                                <TextBlock Text="{l:T Net_OpenWarning}" TextWrapping="Wrap" FontSize="12.5" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Security & adapters -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:T Net_Security}" Style="{StaticResource CardTitle}" />
                            <CheckBox Style="{StaticResource Toggle}" Content="{l:T Net_Isolate}" IsChecked="{Binding IsolateHost}" />
                            <TextBlock Text="{l:T Net_IsolateHint}" Style="{StaticResource Hint}" Margin="54,6,0,0" />

                            <TextBlock Text="{l:T Net_PortalPort}" Style="{StaticResource Label}" Margin="0,18,0,6" />
                            <TextBox Text="{Binding PortalPort, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Width="140" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T Vpn_Title}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{l:T Vpn_Mode}" Style="{StaticResource Label}" />
                            <Border Background="{StaticResource FieldBrush}" CornerRadius="12" Padding="2">
                                <UniformGrid Columns="3">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="VpnMode" Content="{l:T Vpn_ModeOff}" HorizontalContentAlignment="Center"
                                                 IsChecked="{Binding VpnMode, Converter={StaticResource EnumMatch}, ConverterParameter=Off}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="VpnMode" Content="{l:T Vpn_ModeCore}" HorizontalContentAlignment="Center"
                                                 IsChecked="{Binding VpnMode, Converter={StaticResource EnumMatch}, ConverterParameter=BuiltInCore}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="VpnMode" Content="{l:T Vpn_ModePort}" HorizontalContentAlignment="Center"
                                                 IsChecked="{Binding VpnMode, Converter={StaticResource EnumMatch}, ConverterParameter=ExternalPort}" />
                                </UniformGrid>
                            </Border>

                            <!-- Built-in Xray core -->
                            <StackPanel Visibility="{Binding IsCoreMode, Converter={StaticResource Visible}}" Margin="0,12,0,0">
                                <TextBlock Text="{Binding CoreStatus}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                <TextBlock Text="{l:T Vpn_Import}" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="72" VerticalContentAlignment="Top" FontFamily="{StaticResource MonoFont}" FlowDirection="LeftToRight" />
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Left" Content="{l:T Vpn_ImportBtn}" Command="{Binding ImportCommand}" MinWidth="100" />
                                    <Button DockPanel.Dock="Left" Content="{l:T Vpn_PasteImport}" Command="{Binding PasteImportCommand}" Margin="8,0,0,0" MinWidth="100" />
                                    <Button DockPanel.Dock="Right" Content="{l:T Vpn_PingAll}" Command="{Binding PingAllCommand}" MinWidth="100" />
                                </DockPanel>

                                <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" Margin="0,12,0,0" MaxHeight="220"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding PingText}" FontWeight="SemiBold" FlowDirection="LeftToRight" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="{Binding Protocol, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                                                        <Run Text="  " />
                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Endpoint}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" FlowDirection="LeftToRight" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Left" Content="{l:T Vpn_Ping}" Command="{Binding PingSelectedCommand}" MinWidth="90" />
                                    <Button DockPanel.Dock="Left" Content="{l:T Btn_Delete}" Command="{Binding RemoveServerCommand}" Margin="8,0,0,0" MinWidth="90" />
                                    <TextBlock Text="{Binding VpnTestResult}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VpnTestOk}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Text="{l:T Vpn_CoreNote}" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                            </StackPanel>

                            <!-- External VPN app port -->
                            <StackPanel Visibility="{Binding IsExternalMode, Converter={StaticResource Visible}}" Margin="0,12,0,0">
                                <TextBlock Text="{l:T Vpn_Preset}" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{Binding VpnPresets}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedPreset}" />

                                <TextBlock Text="{l:T Vpn_Type}" Style="{StaticResource Label}" Margin="0,14,0,6" />
                                <Border Background="{StaticResource FieldBrush}" CornerRadius="12" Padding="2" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="VpnType" Content="SOCKS5"
                                                     IsChecked="{Binding VpnType, Converter={StaticResource EnumMatch}, ConverterParameter=Socks5}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="VpnType" Content="HTTP"
                                                     IsChecked="{Binding VpnType, Converter={StaticResource EnumMatch}, ConverterParameter=HttpConnect}" />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{l:T Vpn_Host}" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Upstream.Host, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{l:T Vpn_Port}" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Upstream.Port, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
                                    </StackPanel>
                                </Grid>

                                <DockPanel Margin="0,14,0,0">
                                    <Button DockPanel.Dock="Left" Content="{l:T Vpn_Test}" Command="{Binding TestVpnCommand}" MinWidth="110" />
                                    <TextBlock Text="{Binding VpnTestResult}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </DockPanel>
                            </StackPanel>

                            <StackPanel Visibility="{Binding VpnEnabled, Converter={StaticResource Visible}}" Margin="0,12,0,0">
                                <TextBlock Text="{l:T Vpn_Scope}" Style="{StaticResource Label}" />
                                <Border Background="{StaticResource FieldBrush}" CornerRadius="12" Padding="2" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="VpnScope" Content="{l:T Vpn_ScopeAll}"
                                                     IsChecked="{Binding VpnScope, Converter={StaticResource EnumMatch}, ConverterParameter=AllUsers}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="VpnScope" Content="{l:T Vpn_ScopePlans}"
                                                     IsChecked="{Binding VpnScope, Converter={StaticResource EnumMatch}, ConverterParameter=SelectedPlans}" />
                                    </StackPanel>
                                </Border>
                                <CheckBox Style="{StaticResource Toggle}" Content="{l:T Vpn_Fallback}" IsChecked="{Binding Upstream.FallbackDirect}" Margin="0,14,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T Net_Adapters}" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding Adapters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource FieldBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Ipv4}" FlowDirection="LeftToRight" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Speed}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                                                </StackPanel>
                                                <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Up">
                                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  ·  " Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding Kind, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
