<UserControl x:Class="AeroGatePilot.App.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AeroGatePilot.App.Localization">
    <Grid Margin="32,0,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,22">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                    <TextBlock Text="{l:T Users_NewAccount}" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="{l:T Users_Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{l:T Users_Subtitle}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- List -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" Content="{l:T Users_ShowGuests}" IsChecked="{Binding ShowGuests}" Margin="14,0,0,0" />
                    <TextBox Style="{StaticResource SearchBox}" Tag="{l:T Users_Search}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                        Content="{l:T Btn_DeleteGuests}" Command="{Binding DeleteGuestsCommand}"
                        Visibility="{Binding ShowGuests, Converter={StaticResource Visible}}" />
                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{l:T Col_User}" Width="1.4*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource BrandGradient}">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Username}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                                       Visibility="{Binding DisplayName, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:T Col_Plan}" Binding="{Binding PlanName}" Width="*" />
                        <DataGridTextColumn Header="{l:T Col_Used}" Binding="{Binding Used}" Width="1.2*" />
                        <DataGridTextColumn Header="{l:T Col_Time}" Binding="{Binding Time}" Width="*" />
                        <DataGridTextColumn Header="{l:T Col_Expires}" Binding="{Binding Expires}" Width="*" />
                        <DataGridTemplateColumn Header="{l:T Col_Status}" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="999" Padding="10,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#2200CEC9" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="Success"><Setter Property="Background" Value="#332ED573" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="Warning"><Setter Property="Background" Value="#33FFA502" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="Danger"><Setter Property="Background" Value="#33FF4757" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="Muted"><Setter Property="Background" Value="#22FFFFFF" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Editor -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource CardTitle}" FontSize="18" />

                    <TextBlock Text="{l:T Field_Username}" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Editing.Username, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />

                    <TextBlock Text="{l:T Field_DisplayName}" Style="{StaticResource Label}" Margin="0,14,0,6" />
                    <TextBox Text="{Binding Editing.DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{l:T Field_Password}" Style="{StaticResource Label}" Margin="0,14,0,6" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{l:T Btn_Generate}" Command="{Binding GeneratePasswordCommand}" />
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FlowDirection="LeftToRight" />
                    </DockPanel>
                    <TextBlock Text="{l:T Field_PasswordKeep}" Style="{StaticResource Hint}" Visibility="{Binding IsNew, Converter={StaticResource Hidden}}" />

                    <TextBlock Text="{l:T Field_Plan}" Style="{StaticResource Label}" Margin="0,14,0,6" />
                    <ComboBox ItemsSource="{Binding Plans}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Editing.PlanId}" />

                    <CheckBox Style="{StaticResource Toggle}" Content="{l:T Field_Enabled}" IsChecked="{Binding Editing.Enabled}" Margin="0,18,0,0" />

                    <TextBlock Text="{l:T Field_Notes}" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <TextBox Style="{StaticResource MultilineBox}" Text="{Binding Editing.Notes, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Visibility="{Binding IsNew, Converter={StaticResource Hidden}}" Margin="0,18,0,0">
                        <TextBlock Text="{l:T Users_Usage}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding UsageSummary}" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                    </StackPanel>

                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource AccentBrush}" Margin="0,16,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Message, Converter={StaticResource Visible}}" />

                    <Button Style="{StaticResource PrimaryButton}" Content="{l:T Btn_Save}" Command="{Binding SaveCommand}" Margin="0,20,0,0" />
                    <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding IsNew, Converter={StaticResource Hidden}}">
                        <Button Content="{l:T Btn_ResetUsage}" Command="{Binding ResetUsageCommand}" Margin="0,0,4,0" Padding="8,9" />
                        <Button Content="{l:T Btn_Kick}" Command="{Binding KickCommand}" Margin="4,0" Padding="8,9" />
                        <Button Style="{StaticResource DangerButton}" Content="{l:T Btn_Delete}" Command="{Binding DeleteCommand}" Margin="4,0,0,0" Padding="8,9" />
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
